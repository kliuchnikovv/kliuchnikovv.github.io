---
// AuthorBio — identical block at the end of every post.
---

<aside class="author-bio">
  <div class="avatar" aria-hidden="true">VK</div>
  <div class="body">
    <div class="name">Valerii Kliuchnikov</div>
    <div class="desc">
      Go / systems engineer in Barcelona. I write about infrastructure and the things I build.
      <a href="/about/">More →</a>
    </div>
  </div>
</aside>

<style>
  .author-bio {
    display: flex;
    gap: 20px;
    align-items: center;
    padding: 28px 0 24px;
    border-top: 1px solid var(--border);
    max-width: 820px;
  }
  .avatar {
    width: 48px;
    height: 48px;
    border-radius: 50%;
    background: var(--gold-soft);
    color: oklch(0.42 0.14 60);
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 600;
    font-size: 18px;
    flex-shrink: 0;
  }
  [data-theme="dark"] .avatar { color: var(--gold); }

  .body { flex: 1; min-width: 0; }
  .name { font-size: 15px; font-weight: 600; margin-bottom: 2px; }
  .desc { font-size: 14px; line-height: 1.5; color: var(--muted-foreground); }

  @media (max-width: 767px) {
    .avatar { width: 44px; height: 44px; font-size: 16px; }
  }
</style>
