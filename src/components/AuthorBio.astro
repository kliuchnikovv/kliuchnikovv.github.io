---
// AuthorBio — identical block at the end of every post; author from config.
import { author } from '../config';
---

<aside class="author-bio">
  {author.avatar ? (
    <img class="avatar" src={author.avatar} alt={author.name} width="48" height="48" loading="lazy" />
  ) : (
    <div class="avatar monogram" aria-hidden="true">{author.initials}</div>
  )}
  <div class="body">
    <p class="name">{author.name}</p>
    <p class="desc">
      {author.bio}
      <a href={author.aboutHref}>More about me →</a>
    </p>
  </div>
</aside>

<style>
  .author-bio {
    display: flex;
    gap: 20px;
    align-items: center;
    padding: 28px 0 24px;
    border-top: 1px solid var(--border);
    max-width: 820px;
  }
  .avatar {
    width: 48px;
    height: 48px;
    border-radius: 50%;
    flex-shrink: 0;
  }
  img.avatar {
    object-fit: cover;
  }
  .monogram {
    background: var(--gold-soft);
    color: oklch(0.42 0.14 60);
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 600;
    font-size: 18px;
  }
  [data-theme="dark"] .monogram { color: var(--gold); }

  .body { flex: 1; min-width: 0; }
  .name { margin: 0 0 2px; font-size: 15px; font-weight: 600; }
  .desc { margin: 0; font-size: 14px; line-height: 1.5; color: var(--muted-foreground); }
  .desc a { color: var(--primary); white-space: nowrap; }
</style>
