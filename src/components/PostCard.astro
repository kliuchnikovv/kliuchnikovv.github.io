---
/**
 * PostCard — variant A (no thumbnail). Decided in the design session.
 */
import { formatDate } from '../utils/format-date';

interface Props {
  title: string;
  url: string;
  date: Date;
  readingMinutes: number;
  tags: string[];
  description?: string;
  /** When set, this tag is highlighted (active-filter mode). */
  activeTag?: string;
}
const { title, url, date, readingMinutes, tags, description, activeTag } = Astro.props;
---

<article class="post-card">
  <a href={url} class="title-link">
    <div class="meta">
      <time datetime={date.toISOString()}>{formatDate(date)}</time>
      <span aria-hidden="true">·</span>
      <span>{readingMinutes} min read</span>
      <span class="tags">
        {tags.map((tag) => (
          <span class:list={['tag', { active: tag === activeTag }]}>#{tag}</span>
        ))}
      </span>
    </div>
    <h3 class="title">{title}</h3>
    {description && <p class="description">{description}</p>}
  </a>
</article>

<style>
  .post-card {
    padding: 24px 0;
    border-top: 1px solid var(--border);
  }
  .post-card:last-of-type { border-bottom: 1px solid var(--border); }

  .title-link {
    display: block;
    color: inherit;
    text-decoration: none;
  }
  .title-link:hover { text-decoration: none; }
  .title-link:hover .title { color: var(--primary); }

  .meta {
    display: flex;
    align-items: baseline;
    gap: 16px;
    margin-bottom: 10px;
    font-size: 13px;
    color: var(--muted-foreground);
    font-variant-numeric: tabular-nums;
  }
  .tags { margin-left: auto; display: flex; gap: 8px; }
  .tag { color: var(--muted-foreground); }
  .tag.active { color: var(--gold); font-weight: 500; }

  .title {
    margin: 0 0 8px;
    font-size: 24px;
    line-height: 1.3;
    font-weight: 600;
    letter-spacing: -0.01em;
    color: var(--foreground);
    transition: color 0.12s;
  }

  .description {
    margin: 0;
    max-width: 820px;
    font-size: 16px;
    line-height: 1.55;
    color: oklch(from var(--foreground) calc(l + 0.22) c h);
  }

  @media (max-width: 767px) {
    .meta { flex-wrap: wrap; gap: 10px; }
    .tags { margin-left: 0; }
    .title { font-size: 20px; }
  }
</style>
