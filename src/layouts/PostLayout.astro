---
import BaseLayout from './BaseLayout.astro';
import Toc from '../components/Toc.astro';
import TagList from '../components/TagList.astro';
import AuthorBio from '../components/AuthorBio.astro';
import { formatDate } from '../utils/format-date';
import { readingMinutes } from '../utils/reading-time';
import { getEntry } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import type { MarkdownHeading } from 'astro';

interface Props {
  post: CollectionEntry<'posts'>;
  headings: MarkdownHeading[];
  prev?: CollectionEntry<'posts'>;
  next?: CollectionEntry<'posts'>;
}
const { post, headings, prev, next } = Astro.props;
const { title, description, pubDate, tags, project, ogImage } = post.data;
const minutes = readingMinutes(post.body ?? '');
const projectEntry = project ? await getEntry(project) : undefined;
const tocHeadings = headings
  .filter((h) => h.depth === 2 || h.depth === 3)
  .map((h) => ({ depth: h.depth, slug: h.slug, text: h.text }));
---

<BaseLayout
  title={title}
  description={description}
  ogType="article"
  ogImage={ogImage}
  canonicalPath={`/posts/${post.id}/`}
  active="posts"
>
  <article class="post">
    <header class="post-hero">
      <div class="meta">
        <time datetime={pubDate.toISOString()}>{formatDate(pubDate)}</time>
        <span aria-hidden="true">·</span>
        <span>{minutes} min read</span>
        {projectEntry && (
          <>
            <span aria-hidden="true">·</span>
            <a href={`/projects/${projectEntry.id}/`}>{projectEntry.data.title}</a>
          </>
        )}
      </div>
      <h1>{title}</h1>
      {tags.length > 0 && <TagList tags={tags} />}
    </header>

    <div class="post-body">
      {tocHeadings.length > 0 && <Toc headings={tocHeadings} />}
      <div class="prose">
        <slot />
      </div>
    </div>

    <AuthorBio />

    {(prev || next) && (
      <nav class="prevnext" aria-label="Post navigation">
        <div class="pn-slot">{prev && <a href={`/posts/${prev.id}/`}>← {prev.data.title}</a>}</div>
        <div class="pn-slot right">{next && <a href={`/posts/${next.id}/`}>{next.data.title} →</a>}</div>
      </nav>
    )}
  </article>
</BaseLayout>

<style>
  .post {
    max-width: var(--content-page);
    margin: 0 auto;
    padding: 48px var(--page-gutter);
  }
  .post-hero { margin-bottom: 40px; }
  .post-hero .meta {
    display: flex;
    gap: 12px;
    align-items: baseline;
    font-size: 13px;
    color: var(--muted-foreground);
    margin-bottom: 14px;
    flex-wrap: wrap;
  }
  .post-hero h1 {
    margin: 0 0 16px;
    font-size: 44px;
    line-height: 1.15;
    font-weight: 600;
    letter-spacing: -0.02em;
  }

  .post-body {
    display: flex;
    gap: 56px;
    align-items: flex-start;
  }
  .post-body .prose { flex: 1; min-width: 0; }

  .prevnext {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    margin-top: 16px;
    font-size: 14px;
  }
  .pn-slot.right { text-align: right; }

  @media (max-width: 1023px) {
    .post-body { flex-direction: column; gap: 0; }
  }
  @media (max-width: 767px) {
    .post { padding: 32px 20px; }
    .post-hero h1 { font-size: 30px; }
  }
</style>
