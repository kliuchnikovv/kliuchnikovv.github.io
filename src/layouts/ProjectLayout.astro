---
import BaseLayout from './BaseLayout.astro';
import StatusBadge from '../components/StatusBadge.astro';
import { getCollection } from 'astro:content';
import { isPublished } from '../utils/content';
import { formatDate } from '../utils/format-date';
import type { CollectionEntry } from 'astro:content';

interface Props {
  project: CollectionEntry<'projects'>;
}
const { project } = Astro.props;
const { title, tagline, description, status, repo, tech, cover } = project.data;

const related = (await getCollection('posts'))
  .filter(isPublished)
  .filter((p) => p.data.project?.id === project.id)
  .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime());
---

<BaseLayout
  title={title}
  description={description}
  canonicalPath={`/projects/${project.id}/`}
  active="projects"
>
  <article class="project page">
    <header class="project-hero">
      <div class="head">
        <h1>{title}</h1>
        <StatusBadge status={status} />
      </div>
      <p class="tagline">{tagline}</p>
      <div class="facts">
        {repo && <a href={repo} rel="me">Repository ↗</a>}
        {tech.length > 0 && (
          <ul class="tech">
            {tech.map((t) => <li>{t}</li>)}
          </ul>
        )}
      </div>
    </header>

    <div class="prose">
      <slot />
    </div>

    {related.length > 0 && (
      <section class="related">
        <h2>Related posts</h2>
        <ul>
          {related.map((p) => (
            <li>
              <a href={`/posts/${p.id}/`}>{p.data.title}</a>
              <time datetime={p.data.pubDate.toISOString()}>{formatDate(p.data.pubDate)}</time>
            </li>
          ))}
        </ul>
      </section>
    )}

    {cover && <img class="cover" src={cover} alt="" />}
  </article>
</BaseLayout>

<style>
  .project-hero { margin-bottom: 32px; }
  .project-hero .head {
    display: flex;
    align-items: center;
    gap: 14px;
    margin-bottom: 10px;
  }
  .project-hero h1 {
    margin: 0;
    font-size: 36px;
    line-height: 1.15;
    font-weight: 600;
    letter-spacing: -0.02em;
  }
  .tagline {
    margin: 0 0 16px;
    font-size: 18px;
    color: var(--muted-foreground);
  }
  .facts {
    display: flex;
    align-items: center;
    gap: 20px;
    flex-wrap: wrap;
    font-size: 14px;
  }
  .tech {
    display: flex;
    gap: 6px;
    flex-wrap: wrap;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .tech li {
    font-family: var(--font-mono);
    font-size: 11.5px;
    color: var(--muted-foreground);
    padding: 2px 8px;
    background: var(--muted);
    border-radius: var(--radius-sm);
  }

  .related {
    margin-top: 40px;
    padding-top: 24px;
    border-top: 1px solid var(--border);
  }
  .related h2 { font-size: 20px; margin: 0 0 14px; }
  .related ul { list-style: none; margin: 0; padding: 0; }
  .related li {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    padding: 8px 0;
    border-bottom: 1px solid var(--border);
    font-size: 15px;
  }
  .related time { color: var(--muted-foreground); font-size: 13px; }

  .cover {
    width: 100%;
    margin-top: 32px;
    border-radius: var(--radius);
    border: 1px solid var(--border);
  }
</style>
